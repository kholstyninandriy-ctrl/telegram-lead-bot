# ── Copy this file to .env.local and fill in what you have. ───────────────────
# Nothing here is required to start the app: with no keys at all the widget
# runs in demo mode with scripted replies.

# ── Claude (step 3) ──────────────────────────────────────────────────────────
# Get one at https://console.anthropic.com → Settings → API keys.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5. Use claude-sonnet-5 for a cheaper,
# faster demo (roughly 2.5x less per message).
# CLAUDE_MODEL=claude-sonnet-5

# ── Agency identity — change these to re-brand for a client ──────────────────
NEXT_PUBLIC_AGENCY_NAME="Harborview Realty"
NEXT_PUBLIC_ASSISTANT_NAME="Ava"
NEXT_PUBLIC_AGENCY_CITY="Austin"
NEXT_PUBLIC_AGENCY_STATE="TX"
NEXT_PUBLIC_AGENCY_PHONE="(512) 555-0142"
NEXT_PUBLIC_AGENCY_EMAIL="hello@harborviewrealty.com"
NEXT_PUBLIC_AGENCY_SPECIALTY="residential sales and luxury condos"
NEXT_PUBLIC_BRAND_COLOR="#1f6feb"
NEXT_PUBLIC_WELCOME_MESSAGE="Hi! I'm Ava, the virtual receptionist at Harborview Realty. Are you looking to buy, sell, or rent?"

# ── Office hours (drive which appointment slots exist) ───────────────────────
AGENCY_TIMEZONE="America/Chicago"
AGENCY_OPEN_HOUR=9
AGENCY_CLOSE_HOUR=18
# 0 = Sunday … 6 = Saturday
AGENCY_WORKING_DAYS="1,2,3,4,5,6"
AGENCY_APPOINTMENT_MINUTES=30

# ── Supabase ────────────────────────────────────────────────────────────────
# Without these the app still runs, but conversations are kept in memory and
# are lost when the server restarts.
# Supabase → Project Settings → API:
#   URL              → NEXT_PUBLIC_SUPABASE_URL
#   service_role key → SUPABASE_SERVICE_ROLE_KEY   (secret — server only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin dashboard ─────────────────────────────────────────────────────────
# Set this and /admin asks for it. Leave it empty and /admin is open to
# anyone with the link.
ADMIN_PASSWORD=

# Set to 1 to see the real error text in the widget while debugging.
# DEBUG_ERRORS=1

# ── Google Calendar (step 5 — not used yet) ─────────────────────────────────
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_CALENDAR_ID=
