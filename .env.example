# ─── Обов'язкове ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:AA...        # @BotFather
GOOGLE_API_KEY=AIza...                 # Google Cloud → Places API (New)
OPENAI_API_KEY=sk-...                  # потрібен лише для AI-функцій

# ─── Доступ (рекомендовано) ───────────────────────────────────────────────────
# Бот витрачає ТВОЇ платні ключі. Вкажи свій Telegram ID (дізнатись: @userinfobot),
# щоб ботом не користувались сторонні. Порожнє значення = доступ для всіх.
ALLOWED_USER_IDS=

# ─── Apify: добір email там, де сайт закритий Cloudflare або зроблений на JS ──
# Власний парсер безкоштовний, але його зупиняє браузерна перевірка Cloudflare
# і сайти, де контакти малює JavaScript. Apify заходить справжнім браузером.
# Викликається ЛИШЕ для лідів, у яких є сайт, але email не знайшовся.
# Токен: console.apify.com → Settings → API & Integrations.
APIFY_TOKEN=
APIFY_CONTACT_ACTOR=vdrmota~contact-info-scraper   # «Contact Details Scraper»
APIFY_TIMEOUT=180         # скільки чекати на прогін актора, с
APIFY_MAX_SITES=30        # стеля сайтів на один пошук (захист від витрат)
APIFY_PAGES_PER_SITE=10   # скільки сторінок сайту обходити
APIFY_MAX_DEPTH=1
APIFY_MEMORY_MB=2048

# ─── Необов'язкове ────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
MAX_RESULTS=60            # стеля результатів одного пошуку (макс. 60)
SEARCH_CACHE_TTL_MIN=180  # скільки хвилин тримати кеш пошуку; 0 — вимкнути
ENRICH_CONCURRENCY=6      # скільки сайтів бізнесів парсити одночасно
SITE_TIMEOUT=10           # таймаут запиту до сайту бізнесу, с
HTTP_TIMEOUT=15           # таймаут Google Places, с
AI_TIMEOUT=60             # таймаут OpenAI, с
SEND_DELAY=0.35           # пауза між картками лідів, с
DB_PATH=notes.db
LOG_LEVEL=INFO
